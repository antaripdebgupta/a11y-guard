{
  "name": "@a11y-guard/api",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run src/test/integration/"
  },
  "dependencies": {
    "@a11y-guard/config": "workspace:*",
    "@a11y-guard/db": "workspace:*",
    "@a11y-guard/logger": "workspace:*",
    "@a11y-guard/shared-types": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
