# Application Environment
NODE_ENV=development

# Service Ports
PORT=3001
GITHUB_APP_SERVICE_PORT=3002
WEB_PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/a11y_guard?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# MinIO Object Storage Configuration
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="artifacts"

# Mailhog SMTP Configuration
SMTP_HOST="localhost"
SMTP_PORT=1025

# GitHub App Configuration (Local Development Placeholders)
GITHUB_APP_ID="123456"
GITHUB_APP_PRIVATE_KEY_PATH="./github-app-private-key.pem"
GITHUB_WEBHOOK_SECRET="dev_webhook_secret_do_not_use_in_prod"

# Security & CORS
CORS_ORIGIN="http://localhost:3000"
